{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://altora.dev/schemas/money.json",
  "title": "Money",
  "type": "object",
  "required": ["amount", "currency"],
  "additionalProperties": false,
  "properties": {
    "amount": {
      "type": "number",
      "description": "Valor monetário em unidade principal (reais, não centavos)"
    },
    "currency": {
      "type": "string",
      "enum": ["BRL"]
    }
  }
}
