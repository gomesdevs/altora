# Database (Docker Compose → localhost:5433)
DATABASE_URL=postgresql://altora:altora@localhost:5433/altora
REDIS_URL=redis://localhost:6379

# Auth (ADR-005) — use o MESMO AUTH_DEV_SECRET na API e no web
AUTH_MODE=dev
AUTH_DEV_SECRET=altora-local-dev-shared-secret

# Clerk (somente quando AUTH_MODE=clerk)
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Opcional: tenant demo no claim do JWT em modo dev (default Silva FO)
# NEXT_PUBLIC_TENANT_ID=a1111111-1111-4111-8111-111111111111
